<!--
  ios/Runner/Info.plist içindeki en dıştaki <dict> ... </dict> bloğuna eklenir.
  tool/configure_ios.sh bu anahtarları otomatik yazar; elle eklemek istersen
  aşağıdaki satırları kopyalaman yeterli.

  Not: Yerel bildirimler için Info.plist anahtarı GEREKMEZ; izin çalışma
  zamanında istenir (NotificationService.requestPermission).
-->

<!-- HealthKit: okuma izni açıklaması (zorunlu) -->
<key>NSHealthShareUsageDescription</key>
<string>Adım, uyku ve aktif kalori verilerin günlük kokpitinde gösterilmek ve haftalık raporlara eklenmek için okunur.</string>

<!-- HealthKit: yazma açıklaması. Uygulama veri yazmaz; health eklentisi bu anahtarın bulunmasını ister. -->
<key>NSHealthUpdateUsageDescription</key>
<string>Bu uygulama Sağlık verilerine yazmaz; yalnızca okuma yapar.</string>

<!-- Ana ekranda görünen ad -->
<key>CFBundleDisplayName</key>
<string>Ritim</string>

<!-- Yalnızca HTTPS/standart şifreleme kullanılır: ihracat uyumluluğu sorusunu kapatır -->
<key>ITSAppUsesNonExemptEncryption</key>
<false/>

<!-- Türkçe arayüz -->
<key>CFBundleDevelopmentRegion</key>
<string>tr</string>
<key>CFBundleLocalizations</key>
<array>
  <string>tr</string>
</array>

<!-- Yalnızca dikey kullanım -->
<key>UISupportedInterfaceOrientations</key>
<array>
  <string>UIInterfaceOrientationPortrait</string>
</array>

<!--
  ios/Runner/Info.plist içindeki en dıştaki <dict> ... </dict> bloğuna eklenir.
  tool/configure_ios.sh bu anahtarları otomatik yazar; elle eklemek istersen
  aşağıdaki satırları kopyalaman yeterli.

  Not: Yerel bildirimler için Info.plist anahtarı GEREKMEZ; izin çalışma
  zamanında istenir (NotificationService.requestPermission).
-->

<!-- HealthKit: okuma izni açıklaması (zorunlu) -->
<key>NSHealthShareUsageDescription</key>
<string>Adım, uyku, aktif kalori, antrenman, boy ve kilo verilerin günlük kokpitinde gösterilmek ve haftalık raporlara eklenmek için okunur; boy ve kilo yalnızca ilk kurulumda formu doldurmak için okunur.</string>

<!-- HealthKit: yazma açıklaması. Uygulama veri yazmaz; health eklentisi bu anahtarın bulunmasını ister. -->
<key>NSHealthUpdateUsageDescription</key>
<string>Ritim Sağlık verilerine kayıt eklemez; bu izin istenmez.</string>

<!-- Kamera ve fotoğraf arşivi: profil ve ilerleme fotoğrafı -->
<key>NSCameraUsageDescription</key>
<string>Profil ve ilerleme fotoğrafı çekmek için kamera kullanılır; fotoğraf yalnızca sana özel alana yüklenir.</string>
<key>NSPhotoLibraryUsageDescription</key>
<string>Profil ve ilerleme fotoğrafı seçmek için fotoğraf arşivine erişilir; yalnızca seçtiğin fotoğraf küçültülüp sana özel alana yüklenir.</string>

<!-- Ana ekranda görünen ad -->
<key>CFBundleDisplayName</key>
<string>Ritim</string>
<key>CFBundleName</key>
<string>Ritim</string>

<!-- Yalnızca HTTPS/standart şifreleme kullanılır: ihracat uyumluluğu sorusunu kapatır -->
<key>ITSAppUsesNonExemptEncryption</key>
<false/>

<!-- Türkçe arayüz -->
<key>CFBundleDevelopmentRegion</key>
<string>tr</string>
<key>CFBundleLocalizations</key>
<array>
  <string>tr</string>
</array>

<!-- Yalnızca dikey kullanım -->
<key>UISupportedInterfaceOrientations</key>
<array>
  <string>UIInterfaceOrientationPortrait</string>
</array>

